# Copie ce fichier en .env.local (dev) et configure les variables sur Railway (prod).

# URL publique du site (pour les metas SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://garage-auto-sollies.fr

# --- Liaison Lemonauto (à remplir quand on câble le formulaire de devis) ---
# Domaine de l'API Lemonauto (ex: https://app.lemonauto.fr)
NEXT_PUBLIC_DEVIS_API_URL=
# Token partagé avec Lemonauto (route /api/public/devis-request). NE PAS committer.
DEVIS_API_TOKEN=
